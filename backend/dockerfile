# Step 1: Use a lightweight Node base image
FROM node:20-alpine

# Step 2: Create app directory inside the container
WORKDIR /usr/src/app

# Step 3: Copy package files and install dependencies
# Copying these separately leverages Docker's cache layer for faster rebuilds
COPY package*.json ./
RUN npm ci --only=production

# Step 4: Copy the rest of your application code
COPY . .

# Step 5: Expose the port your Express app runs on
EXPOSE 3000

# Step 6: Define the command to run your app
CMD ["node", "server.js"]